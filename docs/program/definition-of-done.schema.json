{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/program/definition-of-done.schema.json",
  "title": "Definition of done",
  "description": "Format of docs/program/definition-of-done.json (ROUNDS-01-L03, DR-0003 decision P8). From S2, each leaf-dag.json node's dod field names the DOD-n items it must meet, and program.mjs rules name the items they enforce.",
  "type": "object",
  "required": ["registry", "revision", "decisionRecord", "description", "changePolicy", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "registry": { "const": "definition-of-done" },
    "revision": { "type": "integer", "minimum": 1 },
    "decisionRecord": { "const": "DR-0003" },
    "description": { "type": "string", "minLength": 1 },
    "changePolicy": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "rule", "appliesTo", "sources", "checkedBy"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^DOD-\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "appliesTo": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "checkedBy": {
            "description": "The leaves whose checks prove the item, each with what it checks.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["leaf", "check"],
              "additionalProperties": false,
              "properties": {
                "leaf": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?-L\\d{2}(/[A-Za-z0-9.]+)?$" },
                "check": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
