{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/program/issue-export.schema.json",
  "title": "Issue export",
  "description": "Format of docs/program/issue-export.json (ROUNDS-01-L03 S2): each filed issue's number, title, and \"Exact prerequisite leaf issues\" section, trimmed from gh issue list by scripts/program/export.mjs. sha256 is the SHA-256 of the issues array as canonical JSON (sorted keys).",
  "type": "object",
  "required": ["description", "source", "sha256", "issues"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["repo", "command", "exportedOn", "section"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "command": { "type": "string", "minLength": 1 },
        "exportedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "section": { "const": "Exact prerequisite leaf issues" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "prerequisites"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "prerequisites": { "type": ["string", "null"] }
        }
      }
    }
  }
}
