{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/program/leaf-dag.schema.json",
  "title": "Leaf DAG",
  "description": "Format of docs/program/leaf-dag.json (ROUNDS-01-L03 S2, DR-0003 decisions P1 and P13), generated by scripts/program/dag.mjs. One node per leaf in contracts/vocabulary/leaf-ids.json; a staged leaf lists its stage ids, the labels its PRs carry ([LEAF-ID/<stage>]). An edge without forStages binds every stage of the dependent; with it, only those stages. A prerequisite is a leaf (every stage, or the stages its satisfiedBy names) or one stage. The folded ids sit in dropped, never as nodes.",
  "type": "object",
  "required": ["description", "decision", "edgeSet", "source", "phases", "milestones", "nodes", "dropped"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "pattern": "^DR-\\d{4}@\\d+$" },
    "edgeSet": { "enum": ["filed", "reauthorized"] },
    "source": {
      "type": "object",
      "required": ["export", "exportSha256", "exportedOn", "inputs", "inputsSha256"],
      "additionalProperties": false,
      "properties": {
        "export": { "const": "docs/program/issue-export.json" },
        "exportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "exportedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "inputs": { "const": "docs/program/leaf-program.json" },
        "inputsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["phase", "title", "spec"],
        "additionalProperties": false,
        "properties": {
          "phase": { "type": "integer", "minimum": 1, "maximum": 9 },
          "title": { "type": "string", "minLength": 1 },
          "spec": { "type": "string", "minLength": 1 }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["milestone", "title", "spec"],
        "additionalProperties": false,
        "properties": {
          "milestone": { "type": "integer", "minimum": 0, "maximum": 7 },
          "title": { "type": "string", "minLength": 1 },
          "spec": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "issue", "status", "capability", "phase", "milestone", "filedPrerequisites"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/leafId" },
          "issue": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["filed", "proposed"] },
          "capability": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?$" },
          "phase": { "type": "integer", "minimum": 1, "maximum": 9 },
          "milestone": { "type": "integer", "minimum": 0, "maximum": 7 },
          "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stageId" } },
          "stagesComplete": { "description": "true when the stage list comes from the body's stage section in leaf-program.json; false when it is only the stages other sections reference.", "type": "boolean" },
          "stagesSource": { "type": "string", "minLength": 1 },
          "satisfiedBy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stageId" } },
          "filedPrerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["prerequisite", "reason", "source"],
              "additionalProperties": false,
              "properties": {
                "prerequisite": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?-L\\d{2}(/[A-Za-z0-9.]+)?$" },
                "forStages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stageId" } },
                "reason": { "type": "string" },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "foldedInto"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/leafId" },
          "foldedInto": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "leafId": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?-L\\d{2}$" },
    "stageId": { "type": "string", "pattern": "^[A-Za-z0-9.]+$" }
  }
}
