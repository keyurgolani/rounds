{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/decisions/decision-record.schema.json",
  "title": "Decision record",
  "description": "Format of every docs/decisions/DR-<nnnn>-<slug>.json (ROUNDS-01-L01). DR-0001 is the product vocabulary, DR-0002 belongs to ROUNDS-01-L02, DR-0003 to ROUNDS-01-L03; later leaves take the next free number at merge. A record may add fields but never drops these. Consumers cite <id>@<revision>.",
  "type": "object",
  "required": ["id", "title", "leaf", "status", "owner", "approver", "approvalRef", "compatibility", "revision", "supersedes", "consumers", "prerequisites", "authorityBoundary", "affectedPackages", "versioning", "supersession", "securityConsequences", "decisions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^DR-\\d{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "leaf": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?-L\\d{2}$" },
    "status": { "enum": ["draft", "ratified", "superseded"] },
    "owner": { "type": "string", "minLength": 1 },
    "approver": { "type": "string" },
    "approvalRef": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["pr", "governedFiles"],
          "additionalProperties": false,
          "properties": {
            "pr": { "type": "integer", "minimum": 1 },
            "governedFiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "sha256"],
                "additionalProperties": false,
                "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
              }
            }
          }
        }
      ]
    },
    "ratifiedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "compatibility": { "enum": ["additive", "breaking"] },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^DR-\\d{4}@\\d+$" }] },
    "supersessionReason": { "type": "string", "minLength": 1 },
    "consumers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "prerequisites": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authorityBoundary": { "type": "string", "minLength": 1 },
    "affectedPackages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "versioning": { "type": "string", "minLength": 1 },
    "supersession": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "securityConsequences": {
      "type": "object",
      "required": ["account", "privacy", "secret", "publicBoundary"],
      "additionalProperties": false,
      "properties": {
        "account": { "type": "string", "minLength": 1 },
        "privacy": { "type": "string", "minLength": 1 },
        "secret": { "type": "string", "minLength": 1 },
        "publicBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "sources", "decision", "alternatives", "consequences", "migrationImpact", "rollbackImpact"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-?[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "ratified", "ratified-here"] },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "decision": { "type": "string", "minLength": 1 },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["option", "reason"],
              "additionalProperties": false,
              "properties": { "option": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
            }
          },
          "consequences": { "type": "string", "minLength": 1 },
          "migrationImpact": { "type": "string", "minLength": 1 },
          "rollbackImpact": { "type": "string", "minLength": 1 }
        }
      }
    },
    "corrections": { "type": "array", "items": { "$ref": "#/$defs/ownerItem" } },
    "specChangeRequests": { "type": "array", "items": { "$ref": "#/$defs/ownerItem" } },
    "departures": { "type": "array", "items": { "$ref": "#/$defs/ownerItem" } }
  },
  "$defs": {
    "ownerItem": {
      "type": "object",
      "required": ["id", "title", "detail"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "citedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
