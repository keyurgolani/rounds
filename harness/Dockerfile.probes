# Probe runner for the account-scope harness. Standard-library Python only
# (urllib), so there is no dependency install and nothing new enters the
# repo's dependency set. The policy file, migration list, and receipts
# directory are bind-mounted at run time; only the probe code is baked in.
FROM python:3.12-slim

WORKDIR /app
COPY probes/ /app/
# The operator-runnable deployment verifier; the harness runs it from here.
COPY verify_deployment.py /app/

ENTRYPOINT ["python", "run.py"]
CMD ["verdict"]
