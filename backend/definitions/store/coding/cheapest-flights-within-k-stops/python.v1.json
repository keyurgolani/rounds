{"cases":[{"case_id":"c000","description":"Classic LC: 0->1->2 (200) beats direct 0->2 (500) when 1 stop allowed","expected":{"literal":200},"input":{"dst":2,"flights":[[0,1,100],[1,2,100],[0,2,500]],"k":1,"n":3,"src":0},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"k=0 forces the direct flight even though it's costlier","expected":{"literal":500},"input":{"dst":2,"flights":[[0,1,100],[1,2,100],[0,2,500]],"k":0,"n":3,"src":0},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Unreachable within budget — needs 2 stops, only 1 allowed","expected":{"literal":-1},"input":{"dst":3,"flights":[[0,1,100],[1,2,100],[2,3,100]],"k":1,"n":4,"src":0},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"src == dst — zero cost, zero edges","expected":{"literal":0},"input":{"dst":0,"flights":[[0,1,100],[1,2,100]],"k":5,"n":3,"src":0},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Single direct flight with k=0","expected":{"literal":42},"input":{"dst":1,"flights":[[0,1,42]],"k":0,"n":2,"src":0},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Cycle in the graph — must not loop forever; answer is 0->1->2->3","expected":{"literal":102},"input":{"dst":3,"flights":[[0,1,1],[1,2,1],[2,0,1],[2,3,100]],"k":5,"n":4,"src":0},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Multi-edge same src->dst — must pick the cheaper parallel edge","expected":{"literal":60},"input":{"dst":2,"flights":[[0,1,200],[0,1,50],[1,2,10]],"k":1,"n":3,"src":0},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Two stops let you take 0->1->2->4 (11) instead of going via 3","expected":{"literal":11},"input":{"dst":4,"flights":[[0,1,5],[1,2,5],[0,2,100],[2,3,5],[3,4,5],[2,4,1]],"k":2,"n":5,"src":0},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Cheap chain needs 3 stops; budget forces the 100-cost direct","expected":{"literal":100},"input":{"dst":4,"flights":[[0,1,5],[1,2,5],[2,3,5],[3,4,5],[0,4,100]],"k":2,"n":5,"src":0},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c009","description":"Better 2-edge path via city 3 — Dijkstra trap if it commits to 1->2 too early","expected":{"literal":2},"input":{"dst":2,"flights":[[0,1,100],[1,2,100],[0,2,500],[0,3,1],[3,2,1]],"k":1,"n":4,"src":0},"tags":["tricky"],"time_class":"standard","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"find_cheapest_price","params":[{"name":"n","type":"any"},{"name":"flights","type":"any"},{"name":"src","type":"any"},{"name":"dst","type":"any"},{"name":"k","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"cheapest-flights-within-k-stops","track":"coding","validators":null,"variant":"python"}