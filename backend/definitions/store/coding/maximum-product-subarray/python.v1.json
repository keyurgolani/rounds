{"cases":[{"case_id":"c000","description":"Best window is [2,3] — the -2 would flip the sign","expected":{"literal":6},"input":{"nums":[2,3,-2,4]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Zero in the middle — best non-empty product is 0","expected":{"literal":0},"input":{"nums":[-2,0,-1]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Two negatives flank a positive — full-array product wins","expected":{"literal":24},"input":{"nums":[-2,3,-4]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Leading zero — best is the singleton 2","expected":{"literal":2},"input":{"nums":[0,2]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Single negative — must return that element (subarray is non-empty)","expected":{"literal":-1},"input":{"nums":[-1]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Single negative, larger magnitude — same rule","expected":{"literal":-2},"input":{"nums":[-2]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Three negatives — best is to skip one to keep the sign positive ([-5,-2,-4,3] is negative; [-5,-2] gives 10; [2,-5,-2] gives 20; [-2,-4,3] gives 24)","expected":{"literal":24},"input":{"nums":[2,-5,-2,-4,3]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Zero resets, then a long negative-rich tail — track both extremes to catch the best signed window","expected":{"literal":960},"input":{"nums":[0,-1,4,-4,5,-2,-1,-1,-2,-3]},"tags":["tricky"],"time_class":"standard","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"max_product","params":[{"name":"nums","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"maximum-product-subarray","track":"coding","validators":null,"variant":"python"}