{"cases":[{"case_id":"c000","description":"Classic LeetCode example — two of four words present","expected":{"matcher":"unordered_deep","value":["eat","oath"]},"input":{"board":[["o","a","a","n"],["e","t","a","e"],["i","h","k","r"],["i","f","l","v"]],"words":["oath","pea","eat","rain"]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Small board, single word that isn't reachable (would need a diagonal)","expected":{"matcher":"unordered_deep","value":[]},"input":{"board":[["a","b"],["c","d"]],"words":["abcd"]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"All five words findable on a 2×2 board, including the looping `abdc`","expected":{"matcher":"unordered_deep","value":["ab","ac","bd","cd","abdc"]},"input":{"board":[["a","b"],["c","d"]],"words":["ab","ac","bd","cd","abdc"]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"None of the words are findable — `abcb` would reuse a cell","expected":{"matcher":"unordered_deep","value":[]},"input":{"board":[["a","b"],["c","d"]],"words":["xyz","qrs","abcb"]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Word longer than the entire 2×2 board — impossible by pigeonhole","expected":{"matcher":"unordered_deep","value":[]},"input":{"board":[["a","b"],["c","d"]],"words":["abcdefghij"]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Single-cell board — only the matching one-letter word is found","expected":{"matcher":"unordered_deep","value":["a"]},"input":{"board":[["a"]],"words":["a","b","ab"]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Words with shared prefixes — Trie sharing must surface every valid prefix","expected":{"matcher":"unordered_deep","value":["oat","oath","eat"]},"input":{"board":[["o","a","a","n"],["e","t","a","e