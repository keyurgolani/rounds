{"cases":[{"case_id":"c000","description":"Classic LC example — overlap with the first only","expected":{"literal":[[1,5],[6,9]]},"input":{"intervals":[[1,3],[6,9]],"newInterval":[2,5]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Classic LC example — merge a run of three (touching at 8)","expected":{"literal":[[1,2],[3,10],[12,16]]},"input":{"intervals":[[1,2],[3,5],[6,7],[8,10],[12,16]],"newInterval":[4,8]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Insert at front, no overlap","expected":{"literal":[[1,2],[3,5],[7,9]]},"input":{"intervals":[[3,5],[7,9]],"newInterval":[1,2]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Insert at end, no overlap","expected":{"literal":[[1,3],[5,7],[9,12]]},"input":{"intervals":[[1,3],[5,7]],"newInterval":[9,12]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"New interval swallows everything","expected":{"literal":[[0,10]]},"input":{"intervals":[[1,2],[3,4],[5,6]],"newInterval":[0,10]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Insert into empty list","expected":{"literal":[[4,7]]},"input":{"intervals":[],"newInterval":[4,7]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Merges first two only","expected":{"literal":[[1,6],[9,11]]},"input":{"intervals":[[1,3],[4,6],[9,11]],"newInterval":[2,5]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Single-interval list, new interval fully contained","expected":{"literal":[[1,5]]},"input":{"intervals":[[1,5]],"newInterval":[2,3]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Single-interval list, no overlap (touches by one)","expected":{"literal":[[1,5],[6,8]]},"input":{"intervals":[[1,5]],"newInterval":[6,8]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c009","description":"Touching exactly on both sides — merge all","expected":{"literal":[[1,9]]},"input":{"intervals":[[1,3],[6,9]],"newInterval":[3,6]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c010","description":"Single interval touching exactly at endpoint","expected":{"literal":[[3,7]]},"input":{"intervals":[[3,5]],"newInterval":[5,7]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c011","description":"Single interval list, new interval fully contains it","expected":{"literal":[[1,10]]},"input":{"intervals":[[2,5]],"newInterval":[1,10]},"tags":["edge"],"time_class":"standard","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"insert_interval","params":[{"name":"intervals","type":"any"},{"name":"newInterval","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"insert-interval","track":"coding","validators":null,"variant":"python"}