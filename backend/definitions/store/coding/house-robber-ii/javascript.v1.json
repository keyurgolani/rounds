{"cases":[{"case_id":"c000","description":"LC example 1 — circular adjacency forbids robbing both ends; pick the middle","expected":{"literal":3},"input":{"nums":[2,3,2]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"LC example 2 — rob houses 0 and 2 (1 + 3); ends are circularly adjacent","expected":{"literal":4},"input":{"nums":[1,2,3,1]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"LC example 3 — three houses, all circularly adjacent; rob only the largest","expected":{"literal":3},"input":{"nums":[1,2,3]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Single house — rob it; circular wrap is trivial","expected":{"literal":5},"input":{"nums":[5]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Two houses — circularly adjacent; pick one","expected":{"literal":3},"input":{"nums":[3,3]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"All zeros — nothing to gain regardless of choice","expected":{"literal":0},"input":{"nums":[0,0,0,0]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"All equal, n=5 — best is two non-adjacent picks (4 + 4)","expected":{"literal":8},"input":{"nums":[4,4,4,4,4]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Circular trap: greedy 200 + 140 + 10 looks tempting, but 200 and 10 wrap-collide; correct is 200 + 140 = 340 via skipping the last","expected":{"literal":340},"input":{"nums":[200,3,140,20,10]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Big payoff at the end forces skipping index 0; rob indices 1 and 4 (3 + 100)","expected":{"literal":103},"input":{"nums":[1,3,1,3,100]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{