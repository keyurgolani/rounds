{"cases":[{"case_id":"c000","description":"Classic: [1,2,3], [2,3,4], [6,7,8]","expected":{"literal":true},"input":{"groupSize":3,"hand":[1,2,3,6,2,3,4,7,8]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Length 5 is not divisible by groupSize 4","expected":{"literal":false},"input":{"groupSize":4,"hand":[1,2,3,4,5]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"groupSize 1 — every singleton is a valid 'run'","expected":{"literal":true},"input":{"groupSize":1,"hand":[1,2,3,4,5]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"groupSize equals length, values are consecutive — single run","expected":{"literal":true},"input":{"groupSize":5,"hand":[1,2,3,4,5]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"groupSize equals length but values are not consecutive (5 missing)","expected":{"literal":false},"input":{"groupSize":5,"hand":[1,2,3,4,6]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Duplicates that align — two copies of [1,2,3]","expected":{"literal":true},"input":{"groupSize":3,"hand":[1,1,2,2,3,3]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Duplicates that misalign — [1,2,3] leaves orphan 1, missing 5","expected":{"literal":false},"input":{"groupSize":3,"hand":[1,1,2,2,3,4]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Spaced by 2 — not consecutive","expected":{"literal":false},"input":{"groupSize":3,"hand":[8,10,12]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Single group, unsorted input","expected":{"literal":true},"input":{"groupSize":3,"hand":[3,2,1]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c009","description":"Multiple groups of 2: [1,2], [3,4], [5,6]","expected":{"literal":true},"input":{"groupSize":2,"hand":[1,2,3,4,5,6]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c010","description":"Multiple groups of 3: [1,2,3], [4,5,6]","expected":{"literal":true},"input":{"groupSize":3,"hand":[1,2,3,4,5,6]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c011","description":"Two identical zeros cannot form a run of 2 (need 0,1)","expected":{"literal":false},"input":{"groupSize":2,"hand":[0,0]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c012","description":"Large values, single consecutive run","expected":{"literal":true},"input":{"groupSize":3,"hand":[1000000000,999999999,999999998]},"tags":["large"],"time_class":"large","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"is_n_straight_hand","params":[{"name":"hand","type":"any"},{"name":"groupSize","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"hand-of-straights","track":"coding","validators":null,"variant":"python"}