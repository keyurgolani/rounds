{"cases":[{"case_id":"c000","description":"Classic — [1,5,5] vs [11], both sum to 11","expected":{"literal":true},"input":{"nums":[1,5,11,5]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Sum = 11, odd → no partition possible","expected":{"literal":false},"input":{"nums":[1,2,3,5]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Sum = 28, target = 14 (e.g. [7,6,1] vs [2,3,4,5])","expected":{"literal":true},"input":{"nums":[1,2,3,4,5,6,7]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Single element — sum is odd, can't split","expected":{"literal":false},"input":{"nums":[1]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"All equal evens — trivially splittable","expected":{"literal":true},"input":{"nums":[2,2,2,2]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Single element with even value — but no second subset to balance it","expected":{"literal":false},"input":{"nums":[100]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Nine ones — sum = 9, odd → False","expected":{"literal":false},"input":{"nums":[1,1,1,1,1,1,1,1,1]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Sum = 18, target = 9 — [4,5] vs [3,3,3]","expected":{"literal":true},"input":{"nums":[3,3,3,4,5]},"tags":["tricky"],"time_class":"standard","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"can_partition","params":[{"name":"nums","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"partition-equal-subset-sum","track":"coding","validators":null,"variant":"javascript"}