{"cases":[{"case_id":"c000","description":"Canonical LeetCode example — 5 ways to flip one of the five 1s","expected":{"literal":5},"input":{"nums":[1,1,1,1,1],"target":3},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Single element, achievable with `+1`","expected":{"literal":1},"input":{"nums":[1],"target":1},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Single element, target unreachable","expected":{"literal":0},"input":{"nums":[1],"target":2},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Empty expression equals target 0 — exactly one way (the empty assignment)","expected":{"literal":1},"input":{"nums":[],"target":0},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Two valid sign assignments: `+1-2+1` and `-1+2-1`","expected":{"literal":2},"input":{"nums":[1,2,1],"target":0},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Eight zeros each freely +/-, plus a fixed `+1` → 2^8 = 256 ways","expected":{"literal":256},"input":{"nums":[0,0,0,0,0,0,0,0,1],"target":1},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Single element matches target exactly","expected":{"literal":1},"input":{"nums":[100],"target":100},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Ten 1000s, target 0 — choose 5 of 10 to be positive: C(10,5) = 252","expected":{"literal":252},"input":{"nums":[1000,1000,1000,1000,1000,1000,1000,1000,1000,1000],"target":0},"tags":["large"],"time_class":"large","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"find_target_sum_ways","params":[{"name":"nums","type":"any"},{"name":"target","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"target-sum","track":"coding","val