{"cases":[{"case_id":"c000","description":"LC example 1 — simple no-carry increment","expected":{"literal":[1,2,4]},"input":{"digits":[1,2,3]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"LC example 2 — no carry","expected":{"literal":[4,3,2,2]},"input":{"digits":[4,3,2,1]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Single zero → one","expected":{"literal":[1]},"input":{"digits":[0]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Single nine — array grows by one","expected":{"literal":[1,0]},"input":{"digits":[9]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"All nines (length 2) — array grows","expected":{"literal":[1,0,0]},"input":{"digits":[9,9]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"All nines (length 3) — array grows","expected":{"literal":[1,0,0,0]},"input":{"digits":[9,9,9]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Mid-array carry propagates to position 0 but does not grow","expected":{"literal":[2,0,0]},"input":{"digits":[1,9,9]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Carry stops after one step","expected":{"literal":[2,4,9,4,0]},"input":{"digits":[2,4,9,3,9]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Trailing zeros — increment the last one","expected":{"literal":[1,0,0,1]},"input":{"digits":[1,0,0,0]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c009","description":"Long carry chain that resolves at the leading digit","expected":{"literal":[9,0,0,0]},"input":{"digits":[8,9,9,9]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c010","description":"Large all-nines (le