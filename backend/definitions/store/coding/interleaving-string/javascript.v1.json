{"cases":[{"case_id":"c000","description":"Classic LC example — valid interleaving","expected":{"literal":true},"input":{"s1":"aabcc","s2":"dbbca","s3":"aadbbcbcac"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Same s1/s2, scrambled s3 — no valid weave","expected":{"literal":false},"input":{"s1":"aabcc","s2":"dbbca","s3":"aadbbbaccc"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"All empty — trivially True","expected":{"literal":true},"input":{"s1":"","s2":"","s3":""},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"s1 empty — s3 must equal s2","expected":{"literal":true},"input":{"s1":"","s2":"abc","s3":"abc"},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"s2 empty — s3 must equal s1","expected":{"literal":true},"input":{"s1":"abc","s2":"","s3":"abc"},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"s2 empty but s3 reorders s1 — order must be preserved","expected":{"literal":false},"input":{"s1":"abc","s2":"","s3":"acb"},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Tiny case — straight concatenation","expected":{"literal":true},"input":{"s1":"a","s2":"b","s3":"ab"},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Tiny case — reverse concatenation","expected":{"literal":true},"input":{"s1":"a","s2":"b","s3":"ba"},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Length mismatch (5 vs 4) — instant False","expected":{"literal":false},"input":{"s1":"ab","s2":"cd","s3":"abcde"},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c009","description":"Perfect alternation a-c-b-d","expected":{"literal":true},"input":{"s1":"ab","s2":"cd","s3":"acbd"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c010","description":"Tricky branching — at index 1 both s1 and s2 offer 'a'; greedy fails","expected":{"literal":true},"input":{"s1":"aa","s2":"ab","s3":"aaba"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c011","description":"Tricky branching — must pick s2's 'a' first then 'b'","expected":{"literal":true},"input":{"s1":"aa","s2":"ab","s3":"abaa"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c012","description":"Repeated 'a's force the DP to explore both sides","expected":{"literal":true},"input":{"s1":"aabc","s2":"abad","s3":"aabadabc"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c013","description":"Stress — 100-char interleave, all-a then all-b","expected":{"literal":true},"input":{"s1":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","s2":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","s3":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},"tags":["large"],"time_class":"large","visibility":"visible"},{"case_id":"c014","description":"Stress — 100-char strict alternation","expected":{"literal":true},"input":{"s1":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","s2":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","s3":"abababababababababababababababababababababababababababababababababababababababababababababababababab"},"tags":["large"],"time_class":"large","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"is_interleave","params":[{"name":"s1","type":"any"},{"name":"s2","type":"any"},{"name":"s3","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"interleaving-string","track":"coding","validators":null,"variant":"javascript"}