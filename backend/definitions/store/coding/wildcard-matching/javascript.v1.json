{"cases":[{"case_id":"c000","description":"Pattern shorter than string with no wildcards","expected":{"literal":false},"input":{"p":"a","s":"aa"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Single `*` matches everything","expected":{"literal":true},"input":{"p":"*","s":"aa"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"`?` matches any single char but next letter mismatches","expected":{"literal":false},"input":{"p":"?a","s":"cb"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"First `*` matches empty, second absorbs `dce`","expected":{"literal":true},"input":{"p":"*a*b","s":"adceb"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Suffix `c?b` cannot align after `*` absorbs","expected":{"literal":false},"input":{"p":"a*c?b","s":"acdcb"},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Both empty — vacuously matches","expected":{"literal":true},"input":{"p":"","s":""},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Empty string matches single `*` (zero chars)","expected":{"literal":true},"input":{"p":"*","s":""},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Empty string matches consecutive stars","expected":{"literal":true},"input":{"p":"***","s":""},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Non-empty string can't match empty pattern","expected":{"literal":false},"input":{"p":"","s":"abc"},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c009","description":"Consecutive stars equivalent to a single `*`","expected":{"literal":true},"input":{"p":"***","s":"abc"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c010","description":"Mixed `*` and `?` — at least 2 chars required","expected":{"literal":true},"input":{"p":"*?*?*","s":"abcd"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c011","description":"Two chars, two `?` separated by stars — fits exactly","expected":{"literal":true},"input":{"p":"*?*?*","s":"ab"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c012","description":"Only one char — cannot satisfy two `?`","expected":{"literal":false},"input":{"p":"*?*?*","s":"a"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c013","description":"Star backtracking — pattern must align tail with `de`","expected":{"literal":true},"input":{"p":"*abc???de*","s":"abcabczzzde"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c014","description":"Trailing `pi` cannot align — classic LC failure case","expected":{"literal":false},"input":{"p":"m??*ss*?i*pi","s":"mississippi"},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c015","description":"Many consecutive stars + suffix — needs star collapse for speed","expected":{"literal":true},"input":{"p":"****************************************************************************************************b","s":""},"tags":["large"],"time_class":"large","visibility":"visible"},{"case_id":"c016","description":"Pattern with multiple stars on a long uniform string","expected":{"literal":true},"input":{"p":"*a*a*a*a*","s":""},"tags":["large"],"time_class":"large","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"is_match","params":[{"name":"s","type":"any"},{"name":"p","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"wildcard-matching","track":"coding","validators":null,"variant":"javascript"}