{"cases":[{"case_id":"c000","description":"Canonical example — mixed waits with two trailing zeros","expected":{"literal":[1,1,4,2,1,1,0,0]},"input":{"temperatures":[73,74,75,71,69,72,76,73]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Strictly increasing — every day waits exactly one","expected":{"literal":[1,1,1,0]},"input":{"temperatures":[30,40,50,60]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Three-day strict increase","expected":{"literal":[1,1,0]},"input":{"temperatures":[30,60,90]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Single day — no future, answer is 0","expected":{"literal":[0]},"input":{"temperatures":[30]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Empty input — empty output","expected":{"literal":[]},"input":{"temperatures":[]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"All equal — equal is not *strictly warmer*, so all zeros","expected":{"literal":[0,0,0]},"input":{"temperatures":[50,50,50]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Plateau then a single warmer day — every duplicate must skip past the others","expected":{"literal":[4,3,2,1,0]},"input":{"temperatures":[73,73,73,73,74]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Mixed peaks and valleys — multiple stack pops in a single step","expected":{"literal":[8,1,5,4,3,2,1,1,0,0]},"input":{"temperatures":[89,62,70,58,47,47,46,76,100,70]},"tags":["tricky"],"time_class":"standard","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"daily_temperatures","params":[{"name":"temperatures","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"daily-temperatures","track":"coding","validators":null,"variant":"javascript"}