{"cases":[{"case_id":"c000","description":"Classic LC example — branch + chain, last node arrives at time 2","expected":{"literal":2},"input":{"k":2,"n":4,"times":[[2,1,1],[2,3,1],[3,4,1]]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Edge points the wrong way — node 1 unreachable from k=2","expected":{"literal":-1},"input":{"k":2,"n":2,"times":[[1,2,1]]},"tags":["edge","unreachable"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Single node, no edges — source already has the signal at time 0","expected":{"literal":0},"input":{"k":1,"n":1,"times":[]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Two nodes, one edge — answer is the edge weight","expected":{"literal":5},"input":{"k":1,"n":2,"times":[[1,2,5]]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Linear chain of 5 — slowest node is the tail at distance 4","expected":{"literal":4},"input":{"k":1,"n":5,"times":[[1,2,1],[2,3,1],[3,4,1],[4,5,1]]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Star graph — every leaf reached in one hop of weight 3","expected":{"literal":3},"input":{"k":1,"n":5,"times":[[1,2,3],[1,3,3],[1,4,3],[1,5,3]]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Multi-edge — direct (10) loses to indirect (1+2=3); Dijkstra must relax","expected":{"literal":3},"input":{"k":1,"n":3,"times":[[1,2,10],[1,3,1],[3,2,2]]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Cycle 1→2→3→1 plus dangling edge to 4 — cycle must not loop forever","expected":{"literal":5},"input":{"k":1,"n":4,"times":[[1,2,1],[2,3,1],[3,1,1],[1,4,5]]},"tags":["tricky","cycle"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Disconnected graph — nodes 3 and 4 unreachable from k=1","expected":{"literal":-1},"input":{"k":1,"n":4,"times":[[1,2,1],[3,4,1]]},"tags":["edge","unreachable"],"time_class":"standard","visibility":"visible"},{"case_id":"c009","description":"Zero-weight edges — instantaneous propagation, answer is 0","expected":{"literal":0},"input":{"k":1,"n":3,"times":[[1,2,0],[2,3,0]]},"tags":["edge"],"time_class":"standard","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"network_delay_time","params":[{"name":"times","type":"any"},{"name":"n","type":"any"},{"name":"k","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"network-delay-time","track":"coding","validators":null,"variant":"javascript"}