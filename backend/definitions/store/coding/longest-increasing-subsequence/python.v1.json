{"cases":[{"case_id":"c000","description":"Classic example — [2,3,7,18] or [2,3,7,101]","expected":{"literal":4},"input":{"nums":[10,9,2,5,3,7,101,18]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Duplicates and dips — LIS is [0,1,2,3]","expected":{"literal":4},"input":{"nums":[0,1,0,3,2,3]},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Strict means equal does not extend — answer is 1","expected":{"literal":1},"input":{"nums":[7,7,7,7,7]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Empty array — no subsequence","expected":{"literal":0},"input":{"nums":[]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Single element — LIS is itself","expected":{"literal":1},"input":{"nums":[1]},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Already sorted — LIS is the whole array","expected":{"literal":5},"input":{"nums":[1,2,3,4,5]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Strictly decreasing — best LIS is any single element","expected":{"literal":1},"input":{"nums":[5,4,3,2,1]},"tags":["tricky"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Non-trivial — best LIS is [1,2,5] (or [3,8,*] cannot reach 3)","expected":{"literal":3},"input":{"nums":[3,1,8,2,5]},"tags":["tricky"],"time_class":"standard","visibility":"visible"}],"content_version":1,"entry":{"kind":"function","name":"length_of_lis","params":[{"name":"nums","type":"any"}],"returns":"any"},"schema":"test-definition/v1","slug":"longest-increasing-subsequence","track":"coding","validators":null,"variant":"python"}