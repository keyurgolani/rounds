{"cases":[{"case_id":"c000","description":"None input → empty string","expected":{"literal":""},"input":{"graph":null},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c001","description":"Empty graph → empty string","expected":{"literal":""},"input":{"graph":{}},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c002","description":"Single-node graph","expected":{"literal":"A"},"input":{"graph":{"A":[]}},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c003","description":"Two-node graph A↔B","expected":{"literal":"AB"},"input":{"graph":{"A":["B"],"B":["A"]}},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c004","description":"Triangle ABC — all three pairwise adjacent","expected":{"literal":"ABC"},"input":{"graph":{"A":["B","C"],"B":["C","A"],"C":["A","B"]}},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c005","description":"Square cycle — the canonical example","expected":{"literal":"ABCD"},"input":{"graph":{"A":["B","D"],"B":["C","A"],"C":["D","B"],"D":["A","C"]}},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c006","description":"Nine-node cycle traced by following neighbour[0] when not prev","expected":{"literal":"ABCDEFGHI"},"input":{"graph":{"A":["B","I"],"B":["C","A"],"C":["B","D"],"D":["E","C"],"E":["D","F"],"F":["E","G"],"G":["H","F"],"H":["I","G"],"I":["A","H"]}},"tags":["basic"],"time_class":"standard","visibility":"visible"},{"case_id":"c007","description":"Invalid — degree-1 nodes (C and D) on a 4-node graph","expected":{"literal":null},"input":{"graph":{"A":["B","D"],"B":["C","A"],"C":["B"],"D":["A"]}},"tags":["edge"],"time_class":"standard","visibility":"visible"},{"case_id":"c008","description":"Invalid — B and C have degree 3 (the 'two squares glued' shape)","expected":{"literal":null},"input":{"graph":{"A":["B","D"],"B":["C","A","E"],"C":["B","D","F"],"D":["A","C"],"E":["B","F"],"F