{
  "$schema": "./policy.schema.json",
  "registry": "rounds-privacy-purposes",
  "description": "Every purpose that calls an AI provider (ROUNDS-14-L01). An unregistered purpose, or a provider helper called from a function no purpose names, is denied and fails the check. The sixteen purposes below start legacy with legacy-implicit consent (register entry 9); ROUNDS-14-L02 passes them with an Intent and no preview, current purposes take per-request consent, and retired ones are refused.",
  "providerHelpers": [
    { "path": "backend/routers/ai.py", "function": "_call_complete" },
    { "path": "backend/routers/ai.py", "function": "_call_stream" },
    { "path": "backend/routers/ai.py", "function": "_fetch_models" },
    { "path": "backend/routers/ai.py", "function": "_anthropic_complete" },
    { "path": "backend/routers/ai.py", "function": "_openai_complete" },
    { "path": "backend/routers/ai.py", "function": "_anthropic_stream" },
    { "path": "backend/routers/ai.py", "function": "_openai_stream" },
    { "path": "backend/routers/sd_practice.py", "function": "_anthropic_stream_with_tools" },
    { "path": "backend/routers/sd_practice.py", "function": "_openai_stream_with_tools" }
  ],
  "providerSupport": [
    { "path": "backend/routers/ai.py", "function": "_models_headers", "note": "Builds the model-list request headers for _fetch_models; calls nothing." }
  ],
  "roles": [
    { "role": "text", "purposes": "every registered purpose" },
    { "role": "vision", "purposes": "none", "note": "The stored vision role has no purpose, so a call through it is denied." }
  ],
