{
  "$schema": "../policy.schema.json",
  "registry": "rounds-privacy-vectors",
  "suite": "packs",
  "description": "Overrides from packs, flags, operators, and users only tighten: a tightening override applies, and a loosening one is refused.",
  "cases": [
    { "id": "tighten.deny-an-allow", "call": "evaluate_sink", "args": { "field_id": "pb:applications.company", "sink": "index", "context": { "overrides": [{ "source": "pack:example", "class": "Private", "sink": "index", "rule": { "decision": "deny", "code": "PACK_OFF" } }] } }, "expect": { "decision": "deny", "code": "PACK_OFF", "rule": "override.pack:example" } },
    { "id": "tighten.add-an-obligation", "call": "evaluate_sink", "args": { "field_id": "pb:applications.company", "sink": "export", "context": { "overrides": [{ "source": "operator", "class": "Private", "sink": "export", "rule": { "decision": "allow", "obligations": ["namespace:account", "export:warning"] } }] } }, "expect": { "decision": "allow", "obligations": ["export:warning", "namespace:account"] } },
    { "id": "tighten.add-a-condition", "call": "evaluate_sink", "args": { "field_id": "pb:applications.company", "sink": "share", "context": { "projection": "reviewed", "overrides": [{ "source": "user", "class": "Private", "sink": "share", "rule": { "decision": "allow-if", "cases": [{ "when": { "projection": "reviewed", "confirmation": "separate" }, "obligations": ["projection:reviewed", "confirmation:separate"] }], "otherwise": "USER_NEEDS_CONFIRMATION" } }] } }, "expect": { "decision": "deny", "code": "USER_NEEDS_CONFIRMATION", "rule": "override.user" } },
    { "id": "tighten.other-class-untouched", "call": "evaluate_sink", "args": { "field_id": "pb:applications.company", "sink": "index", "context": { "overrides": [{ "source": "pack:example", "class": "Sensitive", "sink": "index", "rule": { "decision": "deny", "code": "PACK_OFF" } }] } }, "expect": { "decision": "allow", "obligations": ["namespace:account"] } },
    { "id": "relax.allow-a-secret", "call": "evaluate_sink", "args": { "field_id": "pb:ai_providers.encrypted_key", "sink": "index", "context": { "overrides": [{ "source": "pack:example", "class": "Secret", "sink": "index", "rule": { "decision": "allow", "obligations": [] } }] } }, "expect": { "decision": "deny", "code": "OVERRIDE_RELAXES", "rule": "override.pack:example" } },
    { "id": "relax.drop-a-condition", "call": "evaluate_sink", "args": { "field_id": "pb:applications.company", "sink": "share", "context": { "overrides": [{ "source": "flag:share", "class": "Private", "sink": "share", "rule": { "decision": "allow", "obligations": ["projection:reviewed"] } }] } }, "expect": { "decision": "deny", "code": "OVERRIDE_RELAXES", "rule": "override.flag:share" } },
    { "id": "relax.drop-an-obligation", "call": "evaluate_sink", "args": { "field_id": "pb:applications.company", "sink": "local-draft", "context": { "overrides": [{ "source": "operator", "class": "Private", "sink": "local-draft", "rule": { "decision": "allow", "obligations": ["namespace:account"] } }] } }, "expect": { "decision": "deny", "code": "OVERRIDE_RELAXES", "rule": "override.operator" } },
    { "id": "relax.skip-consent", "call": "evaluate_sink", "args": { "field_id": "pb:applications.company", "sink": "remote-ai", "context": { "consent": { "unit": "none" }, "overrides": [{ "source": "flag:ai_policy", "class": "Private", "sink": "remote-ai", "rule": { "decision": "allow", "obligations": [] } }] } }, "expect": { "decision": "deny", "code": "OVERRIDE_RELAXES", "rule": "override.flag:ai_policy" } },
    { "id": "relax.weaker-consent-unit", "call": "evaluate_sink", "args": { "field_id": "pb:offers.notes", "sink": "remote-ai", "context": { "consent": { "unit": "per-request", "preview": true }, "overrides": [{ "source": "pack:example", "class": "Sensitive", "sink": "remote-ai", "rule": { "decision": "allow-with-consent", "consent": "per-request", "obligations": ["consent:per-request", "preview:payload", "snapshot:provider-payload-snapshot"], "otherwise": "CONSENT_REQUIRED" } }] } }, "expect": { "decision": "deny", "code": "OVERRIDE_RELAXES", "rule": "override.pack:example" } },
    { "id": "relax.open-server-only", "call": "evaluate_sink", "args": { "field_id": "pb:take_home_assignments.harness_files", "sink": "client-read", "context": { "signedIn": true, "overrides": [{ "source": "pack:example", "visibility": "server-only", "sink": "client-read", "rule": { "decision": "allow", "obligations": [] } }] } }, "expect": { "decision": "deny", "code": "OVERRIDE_RELAXES", "rule": "override.pack:example" } },
    { "id": "egress.override-applies", "call": "evaluate_egress", "args": { "purpose": "resume.tailor", "field_ids": ["pb:resumes.data#/experience"], "endpoint": { "role": "text", "host": "api.anthropic.com", "port": 443, "addresses": ["160.79.104.10"] }, "location": "third-party-hosted", "consent": { "unit": "legacy-implicit" }, "context": { "overrides": [{ "source": "pack:example", "class": "Private", "sink": "remote-ai", "rule": { "decision": "deny", "code": "PACK_NO_REMOTE_AI" } }] } }, "expect": { "decision": "deny", "code": "PACK_NO_REMOTE_AI", "rule": "override.pack:example" } }
  ]
}
