    { "id": "secrets.default", "call": "evaluate_retention", "args": { "row_id": "secrets", "value": null, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "value": "until-delete", "expires_at": null, "purge_by": null } },
    { "id": "secrets.delete", "call": "evaluate_retention", "args": { "row_id": "secrets", "value": "delete", "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "expires_at": "2026-01-01T00:00:00Z", "purge_by": "2026-01-02T00:00:00Z" } },
