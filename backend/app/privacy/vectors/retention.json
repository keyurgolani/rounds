    { "id": "capture-inbox.default", "call": "evaluate_retention", "args": { "row_id": "capture-inbox", "value": null, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "value": 30, "expires_at": "2026-01-31T00:00:00Z", "purge_by": "2026-02-01T00:00:00Z", "warn_at": "2026-01-24T00:00:00Z" } },
    { "id": "capture-inbox.seven", "call": "evaluate_retention", "args": { "row_id": "capture-inbox", "value": 7, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "expires_at": "2026-01-08T00:00:00Z", "warn_at": "2026-01-01T00:00:00Z" } },
