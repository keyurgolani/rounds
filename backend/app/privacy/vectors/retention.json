    { "id": "logs-traces.text", "call": "evaluate_retention", "args": { "row_id": "logs-traces", "value": "14", "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "deny", "code": "OUT_OF_BOUNDS", "rule": "lifecycle.logs-traces" } },
