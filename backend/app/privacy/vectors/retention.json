{
  "$schema": "../policy.schema.json",
  "registry": "rounds-privacy-vectors",
  "suite": "retention",
  "description": "evaluate_retention on a fixed clock (anchor 2026-01-01T00:00:00Z): each row's default, its allowed values, an out-of-bound value refused, and purge by the deadline plus 24 hours.",
