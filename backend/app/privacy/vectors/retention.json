    { "id": "encrypted-backups.default", "call": "evaluate_retention", "args": { "row_id": "encrypted-backups", "value": null, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "value": 30, "expires_at": "2026-01-31T00:00:00Z", "purge_by": "2026-02-01T00:00:00Z" } },
    { "id": "encrypted-backups.ninety", "call": "evaluate_retention", "args": { "row_id": "encrypted-backups", "value": 90, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "expires_at": "2026-04-01T00:00:00Z" } },
