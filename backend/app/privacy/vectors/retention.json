    { "id": "canonical.default", "call": "evaluate_retention", "args": { "row_id": "canonical", "value": null, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "value": "until-delete", "expires_at": null, "purge_by": null } },
