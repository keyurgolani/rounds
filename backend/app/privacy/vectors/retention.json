    { "id": "browser-ai-caches.seven", "call": "evaluate_retention", "args": { "row_id": "browser-ai-caches", "value": 7, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "expires_at": "2026-01-08T00:00:00Z", "purge_by": "2026-01-09T00:00:00Z" } },
    { "id": "chat-transcripts.as-attempts", "call": "evaluate_retention", "args": { "row_id": "chat-transcripts", "value": null, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "value": "until-delete", "expires_at": null } },
