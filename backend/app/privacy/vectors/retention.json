    { "id": "failed-intermediates.zero", "call": "evaluate_retention", "args": { "row_id": "failed-intermediates", "value": 0, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "expires_at": "2026-01-01T00:00:00Z", "purge_by": "2026-01-02T00:00:00Z" } },
