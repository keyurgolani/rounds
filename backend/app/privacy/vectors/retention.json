    { "id": "share-view-telemetry.seven", "call": "evaluate_retention", "args": { "row_id": "share-view-telemetry", "value": 7, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "allow", "expires_at": "2026-01-08T00:00:00Z", "purge_by": "2026-01-09T00:00:00Z" } },
