    { "id": "canonical.out-of-bounds", "call": "evaluate_retention", "args": { "row_id": "canonical", "value": 30, "anchor": "2026-01-01T00:00:00Z" }, "expect": { "decision": "deny", "code": "OUT_OF_BOUNDS", "rule": "lifecycle.canonical" } },
