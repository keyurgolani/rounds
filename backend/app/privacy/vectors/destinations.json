{
  "$schema": "../policy.schema.json",
  "registry": "rounds-privacy-vectors",
  "suite": "destinations",
  "description": "classify_destination: the location class from the resolved addresses. Loopback, link-local, metadata addresses, and service names are never destinations, the other non-public ranges get no class, and an IPv6 address that carries an IPv4 one is judged as that address; a private address needs the gate and an allowlist entry, and an IP literal host must match its addresses.",
  "cases": [
    { "id": "never.runner-itself", "call": "classify_destination", "args": { "host": "localhost", "port": 8000, "addresses": ["127.0.0.1"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.pocketbase", "call": "classify_destination", "args": { "host": "pocketbase", "port": 8090, "addresses": ["172.18.0.2"], "settings": { "gate": "enabled", "allowlist": "172.18.0.0/16:8090" } }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.pdf-renderer", "call": "classify_destination", "args": { "host": "pdf-renderer", "port": 4000, "addresses": ["172.18.0.5"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.metadata", "call": "classify_destination", "args": { "host": "169.254.169.254", "port": 80, "addresses": ["169.254.169.254"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.metadata-in-shared-space", "call": "classify_destination", "args": { "host": "metadata.example.com", "port": 80, "addresses": ["100.100.100.200"], "settings": { "gate": "enabled", "allowlist": "100.100.100.0/24:80" } }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.metadata-in-ula", "call": "classify_destination", "args": { "host": "fd00:ec2::254", "port": 80, "addresses": ["fd00:ec2::254"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.mapped-loopback", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["::ffff:127.0.0.1"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.nat64-metadata", "call": "classify_destination", "args": { "host": "models.example.com", "port": 80, "addresses": ["64:ff9b::a9fe:a9fe"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.ipv6-loopback", "call": "classify_destination", "args": { "host": "::1", "port": 11434, "addresses": ["::1"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.service-suffix", "call": "classify_destination", "args": { "host": "runner.rounds.svc", "port": 8000, "addresses": ["10.0.0.9"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.single-label", "call": "classify_destination", "args": { "host": "ollama", "port": 11434, "addresses": ["192.168.1.20"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.link-local-v6", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["fe80::1"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.unspecified-v4", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["0.0.0.0"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.unspecified-v6", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["::"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.container-credentials", "call": "classify_destination", "args": { "host": "models.example.com", "port": 80, "addresses": ["169.254.170.2"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.container-credentials-v2", "call": "classify_destination", "args": { "host": "models.example.com", "port": 80, "addresses": ["169.254.170.23"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.wire-server", "call": "classify_destination", "args": { "host": "models.example.com", "port": 80, "addresses": ["168.63.129.16"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.metadata-v6-credentials", "call": "classify_destination", "args": { "host": "models.example.com", "port": 80, "addresses": ["fd00:ec2::23"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.runner", "call": "classify_destination", "args": { "host": "runner", "port": 8000, "addresses": ["10.0.0.9"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.frontend", "call": "classify_destination", "args": { "host": "frontend", "port": 3000, "addresses": ["10.0.0.10"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.materializer", "call": "classify_destination", "args": { "host": "materializer", "port": 8080, "addresses": ["10.0.0.11"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.localhost-suffix", "call": "classify_destination", "args": { "host": "api.localhost", "port": 8000, "addresses": ["127.0.0.1"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.internal-suffix", "call": "classify_destination", "args": { "host": "metadata.google.internal", "port": 80, "addresses": ["169.254.169.254"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.cluster-suffix", "call": "classify_destination", "args": { "host": "pocketbase.default.cluster.local", "port": 8090, "addresses": ["10.0.0.12"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "never.six-to-four-loopback", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["2002:7f00:1::"] }, "expect": { "decision": "deny", "code": "DESTINATION_NEVER", "rule": "locations.never" } },
    { "id": "unclassed.documentation-range", "call": "classify_destination", "args": { "host": "docs.example.com", "port": 443, "addresses": ["192.0.2.10"] }, "expect": { "decision": "deny", "code": "DESTINATION_UNCLASSED", "rule": "locations" } },
    { "id": "unclassed.local-use-nat64", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["64:ff9b:1::a9fe:a9fe"] }, "expect": { "decision": "deny", "code": "DESTINATION_UNCLASSED", "rule": "locations" } },
    { "id": "unclassed.ipv6-documentation", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["3fff::10"] }, "expect": { "decision": "deny", "code": "DESTINATION_UNCLASSED", "rule": "locations" } },
    { "id": "unclassed.ipv4-compatible", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["::808:808"] }, "expect": { "decision": "deny", "code": "DESTINATION_UNCLASSED", "rule": "locations" } },
    { "id": "unclassed.ipv4-translated", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["::ffff:0:808:808"] }, "expect": { "decision": "deny", "code": "DESTINATION_UNCLASSED", "rule": "locations" } },
    { "id": "unclassed.unresolved", "call": "classify_destination", "args": { "host": "nowhere.example.com", "port": 443, "addresses": [] }, "expect": { "decision": "deny", "code": "DESTINATION_UNCLASSED", "rule": "locations" } },
    { "id": "third-party.public", "call": "classify_destination", "args": { "host": "api.openai.com", "port": 443, "addresses": ["104.18.6.192", "2606:4700::6812:6c0"] }, "expect": { "decision": "allow", "location": "third-party-hosted" } },
    { "id": "mixed.private-and-public", "call": "classify_destination", "args": { "host": "models.example.com", "port": 443, "addresses": ["104.18.6.192", "10.0.0.5"], "settings": { "gate": "enabled", "allowlist": "10.0.0.5:443" } }, "expect": { "decision": "deny", "code": "DESTINATION_MIXED", "rule": "locations" } },
    { "id": "operator.gate-and-entry", "call": "classify_destination", "args": { "host": "10.0.0.5", "port": 11434, "addresses": ["10.0.0.5"], "settings": { "gate": "enabled", "allowlist": "10.0.0.5:11434" } }, "expect": { "decision": "allow", "location": "operator-network" } },
    { "id": "operator.cidr-entry", "call": "classify_destination", "args": { "host": "models.lan.example", "port": 8000, "addresses": ["192.168.1.20", "fd12:3456::20"], "settings": { "gate": "enabled", "allowlist": "192.168.1.0/24:8000,[fd12:3456::/64]:8000" } }, "expect": { "decision": "allow", "location": "operator-network" } },
    { "id": "operator.gate-off", "call": "classify_destination", "args": { "host": "10.0.0.5", "port": 11434, "addresses": ["10.0.0.5"], "settings": { "gate": "disabled", "allowlist": "10.0.0.5:11434" } }, "expect": { "decision": "deny", "code": "DESTINATION_NOT_ALLOWLISTED", "rule": "locations.combination" } },
    { "id": "operator.gate-on-empty-list", "call": "classify_destination", "args": { "host": "10.0.0.5", "port": 11434, "addresses": ["10.0.0.5"], "settings": { "gate": "enabled", "allowlist": "" } }, "expect": { "decision": "deny", "code": "DESTINATION_NOT_ALLOWLISTED", "rule": "locations.combination" } },
    { "id": "operator.other-port", "call": "classify_destination", "args": { "host": "10.0.0.5", "port": 8080, "addresses": ["10.0.0.5"], "settings": { "gate": "enabled", "allowlist": "10.0.0.5:11434" } }, "expect": { "decision": "deny", "code": "DESTINATION_NOT_ALLOWLISTED", "rule": "locations.combination" } },
    { "id": "operator.one-address-outside", "call": "classify_destination", "args": { "host": "models.lan.example", "port": 8000, "addresses": ["192.168.1.20", "192.168.2.20"], "settings": { "gate": "enabled", "allowlist": "192.168.1.0/24:8000" } }, "expect": { "decision": "deny", "code": "DESTINATION_NOT_ALLOWLISTED", "rule": "locations.combination" } },
    { "id": "operator.invalid-allowlist", "call": "classify_destination", "args": { "host": "10.0.0.5", "port": 11434, "addresses": ["10.0.0.5"], "settings": { "gate": "enabled", "allowlist": "pocketbase:8090" } }, "expect": { "decision": "deny", "code": "ALLOWLIST_INVALID", "rule": "locations.allowlistSetting" } },
    { "id": "mismatch.literal-host", "call": "classify_destination", "args": { "host": "10.0.0.5", "port": 11434, "addresses": ["104.18.6.192"] }, "expect": { "decision": "deny", "code": "ADDRESS_MISMATCH", "rule": "locations" } },
    { "id": "input.port-as-text", "call": "classify_destination", "args": { "host": "api.openai.com", "port": "443", "addresses": ["104.18.6.192"] }, "expect": { "decision": "deny", "code": "INPUT_INVALID", "rule": "input.port" } },
    { "id": "input.host-not-text", "call": "classify_destination", "args": { "host": null, "port": 443, "addresses": ["104.18.6.192"] }, "expect": { "decision": "deny", "code": "INPUT_INVALID", "rule": "input.host" } }
  ]
}
