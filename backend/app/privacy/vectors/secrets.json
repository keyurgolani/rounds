{
  "$schema": "../policy.schema.json",
  "registry": "rounds-privacy-vectors",
  "suite": "secrets",
  "description": "detect_secret on texts built from pieces: a string piece is kept as is, and an array piece is joined, so this file holds no contiguous key-shaped string. Offsets are code points. The fixtures and near misses in secret-patterns.json run beside these.",
  "cases": [
    { "id": "clean-text", "call": "detect_secret", "args": { "pieces": ["nothing here but a recruiter's note and a skill list"] }, "expect": null },
    { "id": "empty-text", "call": "detect_secret", "args": { "pieces": [""] }, "expect": null },
    { "id": "two-secrets-in-order", "call": "detect_secret", "args": { "pieces": ["first ", ["gsk_", "EXAMPLEexampleEXAMPLE0"], " then ", ["sd1", "_", "EXAMPLEexampleEXAMPL", "e0"], "."] }, "expect": { "code": "secret-detected", "findings": [{ "pattern": "groq-key", "start": 6, "end": 32 }, { "pattern": "share-link-secret", "start": 38, "end": 64 }] } },
    { "id": "offsets-in-code-points", "call": "detect_secret", "args": { "pieces": ["🔑🔑 ", ["xai-", "EXAMPLEexampleEXAMPLE0"]] }, "expect": { "code": "secret-detected", "findings": [{ "pattern": "xai-key", "start": 3, "end": 29 }] } },
    { "id": "bearer-around-a-key", "call": "detect_secret", "args": { "pieces": ["Authorization: ", ["Bearer ", "sk-", "EXAMPLEexampleEXAMPLE0000"]] }, "expect": { "code": "secret-detected", "findings": [{ "pattern": "bearer-header", "start": 15, "end": 50 }, { "pattern": "openai-key", "start": 22, "end": 50 }] } }
  ]
}
