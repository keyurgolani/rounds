# ==========================================================================
# Rounds — docker compose env
# ==========================================================================
# Copy to `.env` at the repo root. Docker Compose auto-loads this file
# (https://docs.docker.com/compose/environment-variables/env-file/).
# ==========================================================================

# --- Host ports -----------------------------------------------------------
# Host-side ports that the dev compose file publishes.
POCKETBASE_PORT=8090
RUNNER_PORT=3099
FRONTEND_PORT=3001

# --- Production overlay ---------------------------------------------------
# Single port the nginx-fronted frontend binds to when running
# docker-compose.prod.yml. Everything else is reachable only via the
# reverse-proxy paths inside the frontend container.
HTTP_PORT=80

# Published image tag used by docker-compose.prod.yml. Use `latest`, a
# release tag such as `v1.0.0`, or a generated `sha-...` tag.
ROUNDS_IMAGE_TAG=latest

# Optional per-service image overrides. Defaults in docker-compose.prod.yml
# point at Docker Hub. Use these to pin GHCR images instead, for example:
# ROUNDS_FRONTEND_IMAGE=ghcr.io/keyurgolani/rounds-frontend:latest
# ROUNDS_POCKETBASE_IMAGE=ghcr.io/keyurgolani/rounds-pocketbase:latest
# ROUNDS_RUNNER_IMAGE=ghcr.io/keyurgolani/rounds-runner:latest
ROUNDS_FRONTEND_IMAGE=
ROUNDS_POCKETBASE_IMAGE=
ROUNDS_RUNNER_IMAGE=

# --- Runner ---------------------------------------------------------------
# Comma-separated list of allowed origins. Default is wildcard for dev;
# lock down to your domain in prod.
CORS_ALLOW_ORIGINS=*

# The key the runner sends with each write to the admission store, read by
# PocketBase and the runner: at least 32 characters, the same for both,
# such as `openssl rand -hex 32`. Empty, dev compose uses a dev-only
# placeholder and prod compose leaves it unset; set it before enforcing
# idempotency or quotas.
# The execution keys need it on the runner too: without it every code run
# answers 503 execution_disabled and keeps its draft.
ROUNDS_ADMISSION_SECRET=

# The password the runner logs in to the execution job store with, as
# execution-worker, read by PocketBase and the runner: 32 to 72 printable
# characters, the same for both, such as `openssl rand -hex 32`. Neither
# compose file has a default. The job store and the execution keys are on
# by default, so set it before you upgrade: without it every code run
# answers 503 execution_disabled and keeps its draft, and the runner's
# start log names it. Candidate processes never get it.
ROUNDS_EXECUTION_SECRET=

# The password the runner logs in with as share-resolver to resolve share
# links, read by PocketBase and the runner: 32 to 72 printable characters,
# the same for both, such as `openssl rand -hex 32`. Neither compose file
# has a default; empty, no share link resolves. Set it before you set
# ROUNDS_GATE_SHARE_CAPABILITY_RESOLUTION=enabled; candidate processes never
# get it.
# AI_KEY_SECRET keys every share link's digest too, so back it up with
# pb_data (docs/operations.md, "Backups").
ROUNDS_SHARE_RESOLVER_PASSWORD=

# The addresses nginx reaches the runner from, whose X-Real-IP the share
# resolver's throttle counts by, comma-separated CIDRs. Empty keeps loopback
# and the private ranges, where the bundled nginx sits; `none` trusts no
# proxy. A value that can't be read trusts none. A proxy or tunnel in front
# of nginx is set with ROUNDS_FRONTEND_REAL_IP_FROM on the frontend.
ROUNDS_TRUSTED_PROXY_CIDRS=

# --- Frontend -------------------------------------------------------------
# In dev compose the Vite dev server talks to PocketBase directly and
# proxies /api/* to the runner container. In prod compose these two are
# same-origin via nginx — no overrides needed.
VITE_POCKETBASE_URL=http://localhost:8090
VITE_API_PROXY_TARGET=http://runner:8000
VITE_POCKETBASE_PROXY_TARGET=http://pocketbase:8090
VITE_DEV_ALLOWED_HOSTS=localhost

# Prod compose behind a front proxy or tunnel: the addresses it connects to
# nginx from, comma-separated CIDRs, with each client's address in
# X-Forwarded-For. Empty, nginx counts each client by its peer address,
# which is right only when nginx's own port is the public one.
ROUNDS_FRONTEND_REAL_IP_FROM=

# Set to "true" only when the matching provider is configured in the
# PocketBase admin UI (Settings → Auth providers). These flags only
# control whether the buttons render on /login and /signup.
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_GITHUB_ENABLED=false

# Signups. ROUNDS_GATE_SIGNUPS=disabled (in the Gates section below) makes
# a hosted instance invite-only in one place. While it's empty these two
# older flags still work as its aliases: the VITE flag hides signup UI and
# the ROUNDS flag blocks direct PocketBase user creation.
VITE_DISABLE_SIGNUPS=false
ROUNDS_DISABLE_SIGNUPS=false

# The demo account. Off unless this is true, as on a hosted demo: with it
# off, PocketBase refuses the demo account's sign-in and gives it a new
# random password and token key at every start. ROUNDS_GATE_DEMO (in the
# Gates section below) wins when set.
ROUNDS_ENABLE_DEMO=false

# Public share links: any value other than empty, false, 0, no, or off turns
# every share resolve into the uniform not-found, before any lookup. It's
# the alias of ROUNDS_GATE_PUBLIC_SHARES below, which wins when set. The
# runner reads both on each request. See docs/operations.md, "Public shares".
ROUNDS_DISABLE_PUBLIC_SHARES=false

# --- Gates ----------------------------------------------------------------
# ROUNDS_GATE_<NAME> switches, listed in docs/configuration.md#gates.
# Empty keeps each written default. A value outside a gate's list takes
# its most restrictive value and logs an error. Each service reads its
# gates at startup and logs every value, so restart it after a change.
# Gate values aren't secret, so never put a secret in one.
#
# Signups, read by PocketBase and the SPA: enabled or disabled.
ROUNDS_GATE_SIGNUPS=
# The demo account, read by PocketBase: enabled or disabled. Empty leaves
# ROUNDS_ENABLE_DEMO above in charge.
ROUNDS_GATE_DEMO=
# The demo account's code runs, read by the runner: enabled or disabled.
# Empty is disabled: a demo account's run, evaluate, run-project, grade,
# take-home run, and take-home submit answer 503 demo_execution_disabled
# before anything runs, and the pages say code runs are off in the demo.
# enabled gives the demo its code runs back. Other accounts aren't affected.
ROUNDS_GATE_DEMO_EXECUTION=
# Runner routes, enabled or disabled. A disabled route answers 503
# route_disabled.
ROUNDS_GATE_RUN=
ROUNDS_GATE_EVALUATE=
ROUNDS_GATE_AI_CODING_RUN_PROJECT=
ROUNDS_GATE_AI_CODING_GRADE=
ROUNDS_GATE_TAKE_HOME_RUN=
ROUNDS_GATE_TAKE_HOME_SUBMIT=
ROUNDS_GATE_PDF_RENDER=
ROUNDS_GATE_PDF_HEALTH=
ROUNDS_GATE_ATS_RULE=
# The paper_url fetch in /api/ai/improve: enabled or disabled. Off by
# default.
ROUNDS_GATE_PAPER_FETCH=
# AI provider base URLs on private addresses (RFC 1918, RFC 6598, IPv6
# ULA), for a model server on your LAN: enabled or disabled. Off by
# default. Enabled, every account's provider URL can reach this
# deployment's private network, so enable it only when you trust
# every account.
ROUNDS_GATE_PROVIDER_PRIVATE_NETWORK=
# Runner admission steps 6 and 7, idempotency and quotas: off, observe,
# or enforce. Empty is observe, which logs what enforcing would deny and
# denies nothing; the next v* release makes enforce the default.
ROUNDS_GATE_ENFORCE_IDEMPOTENCY=
ROUNDS_GATE_ENFORCE_QUOTA=
# Where the six execution routes get what they run: legacy (the default,
# loaded from PocketBase), enforce (only compiled definitions, named by
# the app's requests), or disabled, which answers 503
# definitions_disabled and keeps every draft. The runner and the
# frontend both read it, so restart both when it changes. Code runs need
# enforce: at any other value the execution keys act as off.
ROUNDS_GATE_EXECUTION_DEFINITIONS=
# The execution job store, read by PocketBase and the runner: on (the
# default), which serves the store's hook routes in PocketBase and runs
# each runner's worker, or off, its emergency stop. It needs
# ROUNDS_EXECUTION_SECRET on both.
ROUNDS_GATE_EXECUTION_STORE=
# Run, evaluate, run-project, and take-home run, read by the runner: on
# (the default, as durable jobs on the store) or off (503
# execution_disabled, drafts kept); legacy acts as off, and no value runs
# code in its request. on needs ROUNDS_GATE_EXECUTION_STORE=on,
# ROUNDS_GATE_EXECUTION_DEFINITIONS=enforce, ROUNDS_EXECUTION_SECRET, and
# ROUNDS_ADMISSION_SECRET; without any of them it acts as off, and the
# runner's start log names what's missing.
ROUNDS_GATE_EXECUTION_SCRATCH=
# Grade, take-home submit, and their rubric reviews, read by the runner: on
# (the default, as durable jobs whose graded row the server writes, each
# reviewed at most once) or off (503 execution_disabled, drafts kept);
# legacy acts as off, and no value grades in the request. on needs what
# ROUNDS_GATE_EXECUTION_SCRATCH's on needs and acts as off without it.
ROUNDS_GATE_EXECUTION_GRADING=
# Public share reads, read by the runner: enabled (the default) or disabled.
# Share capability resolution, read by the runner and the frontend:
# disabled (the default) answers every resolve with the uniform not-found
# and POST /api/share with 503 route_disabled, so no share link resolves and
# nobody can make one. enabled lets POST /api/share/resolve look one up,
# makes POST /api/share CreateShare, and turns rotation on. Opening it is
# the owner's step; do the others in docs/operations.md, "Public shares",
# first.
ROUNDS_GATE_PUBLIC_SHARES=
ROUNDS_GATE_SHARE_CAPABILITY_RESOLUTION=

# Optional admin bootstrap on first PocketBase start. Set strong credentials
# before production deploys; dev compose has safe placeholder defaults.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Hosted demo: https://rounds.keyurgolani.name, which sets
# ROUNDS_ENABLE_DEMO=true. Migration 1700000600_demo_user.js still creates
# the demo account on every install; it can't sign in while the demo is off.
