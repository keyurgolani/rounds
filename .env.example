# ==========================================================================
# Rounds — docker compose env
# ==========================================================================
# Copy to `.env` at the repo root. Docker Compose auto-loads this file
# (https://docs.docker.com/compose/environment-variables/env-file/).
#
# The frontend also reads a separate dev env file at frontend/.env.local
# when running `npm run dev` outside docker (see frontend/.env.example).
# ==========================================================================

# --- Host ports -----------------------------------------------------------
# Host-side ports that the compose services publish. Container-side ports
# are fixed (frontend Vite dev server on 3000, FastAPI on 8000).
BACKEND_PORT=3099
FRONTEND_PORT=3001

# --- Backend --------------------------------------------------------------
# SQLAlchemy URL. The default SQLite file is mounted into the backend
# container at /app/data/interview.db via the ./data volume.
# Point this at a Supabase / Postgres URL to seed that database instead.
DATABASE_URL=sqlite:///./data/interview.db

# --- Frontend -------------------------------------------------------------
# Where Vite proxies /api/* to. Inside docker compose, the backend service
# is reachable at http://backend:8000 — leave the default unless you have
# a reason to change it.
VITE_API_PROXY_TARGET=http://backend:8000

# Supabase credentials. Leave empty to run the FastAPI + mock-auth mode.
# Fill in for production-shaped local dev.
#   Project Settings → API → Project URL + anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" only when the matching provider is configured under
# Supabase → Authentication → Providers. These flags control whether the
# buttons render on /login and /signup.
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_GITHUB_ENABLED=false
