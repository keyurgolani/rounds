{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "containment-corpus-manifest/v2",
  "title": "Containment conformance corpus manifest",
  "description": "Every fixture in issue #8's table by id and family, and nothing else. A fixture's detail lives in its module under corpus/, as SPEC. conformance/manifest.py is the authoritative validator (it also checks each module's SPEC, that each module names a row, and that the set covers every table row); this schema documents the shape.",
  "type": "object",
  "required": ["schema", "corpus_version", "targets", "defaults", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "containment-corpus-manifest/v2"},
    "corpus_version": {"type": "string"},
    "audited_revision": {"type": "string"},
    "targets": {"type": "array", "items": {"enum": ["ci", "compose", "k8s"]}},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemas": {"type": "object"},
        "contract_revisions": {"type": "object"},
        "environment": {"type": "string"},
        "retained_evidence": {"type": "string"}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(EX|FG|RD)-[0-9]{2}$"},
          "family": {"enum": ["execution", "grading", "render"]}
        },
        "allOf": [
          {
            "if": {"properties": {"id": {"pattern": "^EX-"}}},
            "then": {"properties": {"family": {"const": "execution"}}}
          },
          {
            "if": {"properties": {"id": {"pattern": "^FG-"}}},
            "then": {"properties": {"family": {"const": "grading"}}}
          },
          {
            "if": {"properties": {"id": {"pattern": "^RD-"}}},
            "then": {"properties": {"family": {"const": "render"}}}
          }
        ]
      }
    }
  }
}
