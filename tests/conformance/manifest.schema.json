{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "containment-corpus-manifest/v1",
  "title": "Containment conformance corpus manifest",
  "description": "One row per fixture in issue #8's table. conformance/manifest.py is the authoritative validator (it also checks that a contained row has a module, a pending row has none, and the set covers every table row); this schema documents the shape.",
  "type": "object",
  "required": ["schema", "corpus_version", "targets", "defaults", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "containment-corpus-manifest/v1"},
    "corpus_version": {"type": "string"},
    "audited_revision": {"type": "string"},
    "targets": {"type": "array", "items": {"enum": ["ci", "compose", "k8s"]}},
    "defaults": {
      "type": "object",
      "properties": {
        "languages": {"type": "array", "items": {"enum": ["python", "javascript", "typescript"]}},
        "control": {"type": "string"},
        "destructive": {"type": "boolean"},
        "environment_sensitive": {"type": "boolean"},
        "schemas": {"type": "object"},
        "contract_revisions": {"type": "object"},
        "environment": {"type": "string"},
        "retained_evidence": {"type": "string"}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "attack", "spec_ref", "status", "closing_leaf", "routes", "setup", "teardown"],
        "properties": {
          "id": {"type": "string", "pattern": "^(EX|FG|RD)-[0-9]{2}$"},
          "attack": {"type": "string"},
          "spec_ref": {"type": "string"},
          "status": {"enum": ["contained", "pending", "not-applicable"]},
          "closing_leaf": {"type": "string"},
          "module": {"type": "string"},
          "routes": {"type": "array", "items": {"type": "string"}},
          "languages": {"type": "array", "items": {"enum": ["python", "javascript", "typescript"]}},
          "control": {"type": "string"},
          "destructive": {"type": "boolean"},
          "environment_sensitive": {"type": "boolean"},
          "setup": {"type": "string"},
          "teardown": {"type": "string"},
          "reason": {"type": "string"},
          "guarantee": {"type": "string"},
          "subcases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "status", "closing_leaf"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^(EX|FG|RD)-[0-9]{2}\\.[a-z0-9-]+$"},
                "status": {"enum": ["contained", "pending"]},
                "closing_leaf": {"type": "string", "pattern": "^ROUNDS-"}
              }
            }
          },
          "expected": {
            "type": "object",
            "properties": {
              "ci": {"enum": ["contained", "not-applicable"]},
              "compose": {"enum": ["contained", "not-applicable"]},
              "k8s": {"enum": ["contained", "not-applicable"]}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "contained"}}},
            "then": {"required": ["module", "expected", "subcases"]}
          },
          {
            "if": {"properties": {"status": {"const": "pending"}}},
            "then": {"not": {"required": ["module"]}}
          }
        ]
      }
    }
  }
}
