# ==========================================================================
# Rounds frontend — env vars
# ==========================================================================
# Copy to `.env.local` during development. None are committed. Only
# `VITE_*` variables ship to the browser bundle.
# ==========================================================================

# --- PocketBase (required) ------------------------------------------------
# Absolute URL to the PocketBase instance. Leave blank in production to
# use the same-origin `/pb` prefix served by the reverse proxy.
VITE_POCKETBASE_URL=http://localhost:8090

# --- OAuth providers -------------------------------------------------------
# Set to "true" only when the matching provider is configured in the
# PocketBase admin UI (Settings → Auth providers). These flags only
# control whether the buttons render on the login / signup pages.
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_GITHUB_ENABLED=false

# Hide signup links/forms in the SPA. Hosted instances should also set
# ROUNDS_DISABLE_SIGNUPS=true for PocketBase server-side enforcement.
VITE_DISABLE_SIGNUPS=false

# --- Legacy FastAPI proxy (dev only) --------------------------------------
# Used by the coding runner (/api/run, /api/evaluate). Vite proxies
# /api/* to this target in development.
VITE_API_PROXY_TARGET=http://127.0.0.1:3099
VITE_POCKETBASE_PROXY_TARGET=http://127.0.0.1:8090
VITE_DEV_ALLOWED_HOSTS=localhost
