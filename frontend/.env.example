# ==========================================================================
# Rounds frontend — env vars
# ==========================================================================
# Copy to `.env.local` during development. In Vercel, set these under
# Project Settings → Environment Variables (Production + Preview).
#
# None are committed. Only `VITE_*` variables ship to the browser bundle.
# ==========================================================================

# --- Supabase (required for production) -----------------------------------
# Project URL from Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=
# `anon` public key from the same page. Safe to embed in the client — RLS
# guards per-user data.
VITE_SUPABASE_ANON_KEY=

# --- OAuth providers -------------------------------------------------------
# Set to "true" only when the matching provider is configured in Supabase
# (Authentication → Providers). These flags control whether the buttons
# render on the login / signup pages.
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_GITHUB_ENABLED=false

# --- Legacy FastAPI proxy (dev only) --------------------------------------
# Only needed when running the self-hosted FastAPI backend locally instead
# of Supabase. Vite proxies /api/* to this target.
VITE_API_PROXY_TARGET=http://127.0.0.1:3099
