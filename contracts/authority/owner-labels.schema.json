{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/authority/owner-labels.schema.json",
  "title": "Capability owner labels",
  "description": "Shape of contracts/authority/owner-labels.json (ROUNDS-01-L02): each catalog owner label mapped to one service package, none, blocked:OD-1, or per-row.",
  "type": "object",
  "required": ["registry", "labels"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "registry": { "const": "rounds-owner-labels" },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "label", "service"],
        "additionalProperties": false,
        "properties": {
          "capability": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?$" },
          "label": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*|blocked:OD-\\d+)$" },
          "rows": {
            "description": "Row id to service package, for rows whose service differs from service (all rows when service is per-row).",
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
