{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/authority/packages.schema.json",
  "title": "Service packages",
  "description": "Shape of contracts/authority/packages.json (ROUNDS-01-L02): one package per spec service (spec 1917-1935). Decision records name packages in affectedPackages by id or service.",
  "type": "object",
  "required": ["registry", "auditedRevision", "packages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "registry": { "const": "rounds-packages" },
    "auditedRevision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "service", "spec", "baseline_locations", "target_path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "service": { "type": "string", "minLength": 1 },
          "spec": { "type": "string", "pattern": "^spec \\d+$" },
          "baseline_locations": {
            "description": "Paths at the audited revision (a trailing / names a directory), or n/a:<reason>.",
            "type": ["array", "string"],
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "pattern": "^n/a:\\S.*$"
          },
          "target_path": { "type": "string", "pattern": "^(pending:ROUNDS-\\d{2}[A-Z]?-L\\d{2}|[a-z0-9_./-]+)$" }
        }
      }
    }
  }
}
