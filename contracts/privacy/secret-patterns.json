{
  "$schema": "./policy.schema.json",
  "registry": "rounds-privacy-secret-patterns",
  "description": "Fixed patterns detect_secret matches (ROUNDS-14-L01). It answers secret-detected with each pattern id and offsets in code points, never the match. Patterns stay inside a subset Python's re (with re.ASCII) and JavaScript read the same way: ASCII character classes, lookahead, a one-character lookbehind, no named groups, no inline flags. Every run is bounded or starts where its characters start, so a scan stays linear in the text, and the PEM pattern matches the header alone, which is enough to refuse the text. A text longer than maxCodePoints answers text-too-long without a scan, and the caller refuses it the same way. Fixtures are synthetic and stored as parts joined at test time, so this file never holds a contiguous key-shaped string. A caller that adds a pattern adds a fixture and a near miss for it.",
  "maxCodePoints": 1000000,
  "patterns": [
    { "id": "anthropic-key", "class": "provider credential", "regex": "sk-ant-[A-Za-z0-9_-]{20,}" },
    { "id": "openai-key", "class": "provider credential", "regex": "sk-(?!ant-|or-)(?:proj-)?[A-Za-z0-9_-]{20,}" },
    { "id": "openrouter-key", "class": "provider credential", "regex": "sk-or-v1-[0-9a-f]{32,}" },
    { "id": "google-key", "class": "provider credential", "regex": "AIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])" },
    { "id": "groq-key", "class": "provider credential", "regex": "gsk_[A-Za-z0-9]{20,}" },
    { "id": "xai-key", "class": "provider credential", "regex": "xai-[A-Za-z0-9]{20,}" },
    { "id": "huggingface-token", "class": "provider credential", "regex": "hf_[A-Za-z0-9]{30,}" },
    { "id": "github-token", "class": "provider credential", "regex": "(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}" },
    { "id": "bearer-header", "class": "bearer credential", "regex": "Bearer[ \\t]+[A-Za-z0-9._~+/=-]{16,}" },
    { "id": "jwt", "class": "session token", "regex": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{8,8192}\\.eyJ[A-Za-z0-9_-]{8,8192}\\.[A-Za-z0-9_-]{8,8192}" },
    { "id": "pem-private-key", "class": "encryption key", "regex": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----" },
    { "id": "share-link-secret", "class": "share link secret", "regex": "\\bsd\\d{1,3}_[\\w-]{22}(?![\\w-])" }
  ],
  "fixtures": [
    { "pattern": "anthropic-key", "before": "key: ", "parts": ["sk-ant-", "api03-", "EXAMPLEexampleEXAMPLE0000"], "after": " (placeholder)" },
    { "pattern": "openai-key", "before": "OPENAI=", "parts": ["sk-", "proj-", "EXAMPLEexampleEXAMPLE00"], "after": "" },
    { "pattern": "openai-key", "before": "", "parts": ["sk-", "EXAMPLEexampleEXAMPLE0000"], "after": " trailing" },
    { "pattern": "openrouter-key", "before": "router ", "parts": ["sk-or-v1-", "0123456789abcdef", "0123456789abcdef"], "after": "" },
    { "pattern": "google-key", "before": "g=", "parts": ["AIza", "EXAMPLEexampleEXAMPLE", "exampleEXAMPLE"], "after": ";" },
    { "pattern": "groq-key", "before": "", "parts": ["gsk_", "EXAMPLEexampleEXAMPLE0"], "after": "" },
    { "pattern": "xai-key", "before": "x ", "parts": ["xai-", "EXAMPLEexampleEXAMPLE0"], "after": " y" },
    { "pattern": "huggingface-token", "before": "", "parts": ["hf_", "EXAMPLEexampleEXAMPLEexample0000"], "after": "" },
    { "pattern": "github-token", "before": "token ", "parts": ["ghp_", "EXAMPLEexampleEXAMPLEexample", "EXAMPLE0"], "after": "" },
    { "pattern": "github-token", "before": "", "parts": ["github_", "pat_", "EXAMPLE_example_EXAMPLE_0"], "after": "" },
    { "pattern": "bearer-header", "before": "Authorization: ", "parts": ["Bearer ", "EXAMPLEexample.EXAMPLE"], "after": "\n" },
    { "pattern": "jwt", "before": "t=", "parts": ["eyJ", "EXAMPLEexample", ".eyJ", "EXAMPLEexample", ".EXAMPLEexample"], "after": "&x" },
    { "pattern": "pem-private-key", "before": "", "parts": ["-----BEGIN ", "PRIVATE KEY-----"], "after": "\nEXAMPLEEXAMPLE\n-----END PRIVATE KEY-----\n" },
    { "pattern": "pem-private-key", "before": "x\n", "parts": ["-----BEGIN ", "EC ", "PRIVATE KEY-----"], "after": "\nEXAMPLE\n-----END EC PRIVATE KEY-----" },
    { "pattern": "share-link-secret", "before": "link #", "parts": ["sd1", "_", "EXAMPLEexampleEXAMPL", "e0"], "after": " sent" },
    { "pattern": "share-link-secret", "before": "\u00e9\ud83d\ude00 ", "parts": ["sd12", "_", "EXAMPLEexampleEXAMPL", "e0"], "after": "" }
  ],
  "nearMisses": [
    { "pattern": "anthropic-key", "before": "the prefix ", "parts": ["sk-ant-", "short"], "after": " alone" },
    { "pattern": "openai-key", "before": "", "parts": ["sk-", "too-short"], "after": "" },
    { "pattern": "openrouter-key", "before": "", "parts": ["sk-or-v1-", "0123456789abcdef"], "after": " (hex too short)" },
    { "pattern": "google-key", "before": "", "parts": ["AIza", "EXAMPLEexampleEXAMPLE", "exampleEXAMPL"], "after": " (one short)" },
    { "pattern": "google-key", "before": "", "parts": ["AIza", "EXAMPLEexampleEXAMPLE", "exampleEXAMPLEee"], "after": " (one long)" },
    { "pattern": "groq-key", "before": "", "parts": ["gsk_", "short"], "after": "" },
    { "pattern": "xai-key", "before": "the ", "parts": ["xai-", "prefix"], "after": " in prose" },
    { "pattern": "huggingface-token", "before": "", "parts": ["hf_", "short"], "after": "" },
    { "pattern": "github-token", "before": "", "parts": ["ghp_", "EXAMPLEexample"], "after": " (too short)" },
    { "pattern": "bearer-header", "before": "the ", "parts": ["Bearer ", "token"], "after": " goes in a header" },
    { "pattern": "jwt", "before": "starts with ", "parts": ["eyJ", "hbGciOi"], "after": " only" },
    { "pattern": "jwt", "before": "glued", "parts": ["eyJ", "EXAMPLEexample", ".eyJ", "EXAMPLEexample", ".EXAMPLEexample"], "after": " (inside a word)" },
    { "pattern": "pem-private-key", "before": "", "parts": ["-----BEGIN ", "PUBLIC KEY-----", "\nEXAMPLE\n", "-----END ", "PUBLIC KEY-----"], "after": "" },
    { "pattern": "share-link-secret", "before": "", "parts": ["sd1", "_", "EXAMPLEexampleEXAMP", "e0"], "after": " (one short)" },
    { "pattern": "share-link-secret", "before": "", "parts": ["sd1", "_", "EXAMPLEexampleEXAMPLE", "e0"], "after": " (one long)" },
    { "pattern": "share-link-secret", "before": "x", "parts": ["sd1", "_", "EXAMPLEexampleEXAMPL", "e0"], "after": " (inside a word)" }
  ]
}
