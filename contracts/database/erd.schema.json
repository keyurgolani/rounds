{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/database/erd.schema.json",
  "title": "Entity relationship diagram of the canonical database, generated",
  "description": "DR-0004's ERD (ROUNDS-02-L01), generated: every PocketBase collection and system table, the platform tables and stores DR-0004 places, and every relation with its cardinality, account partition, delete behavior, merge behavior, and indexes. scripts/conformance/rules/database-adr.mjs builds it from schema-snapshot.json and the written part, erd-decisions.json, which DR-0004 ratifies; this file is not edited by hand.",
  "type": "object",
  "required": ["$schema", "registry", "decisionRecord", "revision", "description", "decisions", "snapshot", "semantics", "stores", "groups", "entities", "relations"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "registry": { "const": "rounds-erd" },
    "decisionRecord": { "type": "string", "pattern": "^DR-\\d{4}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "decisions": { "const": "contracts/database/erd-decisions.json" },
    "snapshot": {
      "type": "object",
      "required": ["path", "revision", "pocketbaseVersion"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pocketbaseVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "semantics": {
      "description": "The written part's delete and merge values, plus the delete behavior PocketBase showed for each relation shape on the snapshot's native run.",
      "type": "object",
      "required": ["onDelete", "onAccountDelete", "merge", "measured"],
      "additionalProperties": false,
      "properties": {
        "onDelete": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "onAccountDelete": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "merge": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "measured": { "type": "object" }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "location", "process", "canonical", "backup", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": { "enum": ["sqlite", "files", "object-store"] },
          "location": { "type": "string", "minLength": 1 },
          "process": { "type": "string", "minLength": 1 },
          "canonical": { "type": "boolean" },
          "backup": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["live", "planned"] }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "title": { "type": "string", "minLength": 1 } }
      }
    },
    "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entity" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }
  },
  "$defs": {
    "leafRef": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?-L\\d{2}(/[A-Za-z0-9.]+)?$" },
    "entity": {
      "type": "object",
      "required": ["id", "status", "kind", "store", "group", "scope", "partition", "writers", "purge"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^_?[A-Za-z][A-Za-z0-9_]*$" },
        "status": { "enum": ["live", "planned", "held"] },
        "kind": { "enum": ["collection", "system-table", "file-store"] },
        "type": { "enum": ["base", "auth", "view"] },
        "store": { "type": "string", "minLength": 1 },
        "bytes": { "type": "boolean" },
        "group": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["account", "content", "platform", "service", "system"] },
        "partition": {
          "type": ["object", "null"],
          "required": ["field", "kind", "onAccountDelete"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["relation", "text", "self"] },
            "onAccountDelete": { "enum": ["cascade", "restrict", "unset", "purge", "expiry", "pocketbase"] }
          }
        },
        "partitionIndexed": { "type": "boolean" },
        "fields": { "type": "integer", "minimum": 0 },
        "indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "unique", "columns"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "unique": { "type": "boolean" }, "columns": { "type": "array", "items": { "type": "string" } }, "partial": { "type": "boolean" } }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": { "enum": ["null", "open", "expression"] }
        },
        "createdBy": { "type": "string", "minLength": 1 },
        "owningLeaf": { "$ref": "#/$defs/leafRef" },
        "rows": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "writers": { "type": "string", "minLength": 1 },
        "purge": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "status": { "enum": ["planned", "held"] } } },
      "then": { "required": ["owningLeaf"] }
    },
    "relation": {
      "type": "object",
      "required": ["id", "status", "from", "field", "to", "cardinality", "required", "onDelete", "merge", "authorization"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^_?[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$" },
        "status": { "enum": ["live", "planned", "held"] },
        "from": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "cardinality": { "enum": ["many-to-one", "many-to-many"] },
        "required": { "type": "boolean" },
        "cascadeDelete": { "type": "boolean" },
        "onDelete": { "enum": ["cascade", "restrict", "unset", "purge"] },
        "merge": { "enum": ["none", "repoint", "n/a"] },
        "authorization": { "enum": ["relation-endpoint", "owner", "content", "server"] },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
