{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rounds:contracts:definitions:artifact-renderer:v1",
  "title": "artifact-renderer/v1",
  "description": "The server-owned contract a PDF renders through (ROUNDS-00A-L02): one allowlisted template, its pinned bundle and packages, and the only design overrides a user can set. #4 rejects anything else as design_out_of_domain; nothing after #4's snapshot falls back to another template.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "template_id", "template_bundle_checksum", "renderer_version", "font_package_version", "overrides"],
  "properties": {
    "schema": { "const": "artifact-renderer/v1" },
    "template_id": {
      "description": "The 19 templates in frontend/src/features/resume/templates/registry.ts.",
      "enum": [
        "modern", "classic", "executive", "swe-latex", "compact", "timeline", "editorial", "brutalist-mono",
        "notion", "geometric", "split", "confetti", "aperture", "typewriter", "linear", "inverted", "banner",
        "display", "langstaff"
      ]
    },
    "template_bundle_checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "renderer_version": { "$ref": "#/$defs/package_version" },
    "font_package_version": { "$ref": "#/$defs/package_version" },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "margin": { "description": "Millimetres.", "type": "number", "minimum": 0, "maximum": 30 } }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": { "description": "Points.", "type": "number", "minimum": 9, "maximum": 12 },
                "family": { "$ref": "#/$defs/font_id" }
              }
            },
            "heading": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "family": { "$ref": "#/$defs/font_id" } }
            }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
        },
        "bulletStyle": {
          "description": "The 16 markers in DesignSidebar.tsx.",
          "enum": [
            "disc", "circle", "square", "dot", "dash", "arrow", "arrow-long", "chevron", "triangle", "check",
            "star", "star-outline", "diamond", "plus", "asterisk", "none"
          ]
        }
      }
    }
  },
  "$defs": {
    "package_version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "font_id": {
      "description": "The seven font families the templates use, as the font ids #6 packages.",
      "enum": ["inter", "playfair-display", "source-serif-pro", "source-sans-pro", "cmu-serif", "jetbrains-mono", "courier-prime"]
    }
  }
}
