{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/vocabulary/leaf-ids.schema.json",
  "title": "Leaf ID registry",
  "description": "Every leaf ID a repository file may reference. Owned by ROUNDS-01-L01; #17 checks its DAG against it (DAG_LEAF_IDS_DRIFT).",
  "type": "object",
  "required": ["catalog", "leaves"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "catalog": {
      "type": "object",
      "required": ["source", "sha256", "schemaVersion", "designContractVersion", "auditedRevision", "leafCount"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "designContractVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "auditedRevision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "leafCount": { "type": "integer", "minimum": 1 }
      }
    },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A rejected leaf has foldedInto and no issue; a filed or proposed leaf has an issue and no foldedInto. The rule checks both.",
        "type": "object",
        "required": ["id", "issue", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?-L\\d{2}$" },
          "issue": { "type": ["integer", "null"], "minimum": 1 },
          "status": { "enum": ["filed", "proposed", "rejected"] },
          "foldedInto": { "type": "string", "pattern": "^ROUNDS-\\d{2}[A-Z]?-L\\d{2}$" }
        }
      }
    }
  }
}
